<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Avatar Background Circle -->
        <View
            android:id="@+id/vAvatarBg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_avatar_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- User Custom Vector Icon -->
        <ImageView
            android:id="@+id/ivUserIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="User Icon"
            android:src="@drawable/ic_user_avatar"
            app:tint="@color/lime_accent"
            app:layout_constraintBottom_toBottomOf="@id/vAvatarBg"
            app:layout_constraintEnd_toEndOf="@id/vAvatarBg"
            app:layout_constraintStart_toStartOf="@id/vAvatarBg"
            app:layout_constraintTop_toTopOf="@id/vAvatarBg" />

        <!-- ID Badge Pill Chip -->
        <TextView
            android:id="@+id/tvId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ID: 1"
            android:textColor="@color/lime_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Full Name -->
        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvId"
            app:layout_constraintStart_toEndOf="@id/vAvatarBg"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Role Subtitle / Tag -->
        <TextView
            android:id="@+id/tvRoleTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="Usuario Registrado REST"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/vAvatarBg"
            app:layout_constraintTop_toBottomOf="@id/tvNombre" />

        <!-- Horizontal Divider -->
        <View
            android:id="@+id/dividerLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vAvatarBg" />

        <!-- Email Container -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="10dp"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_mail_custom"
            app:drawableTint="@color/lime_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerLine" />

        <!-- Phone Container -->
        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="10dp"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_phone_custom"
            app:drawableTint="@color/cyan_accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
